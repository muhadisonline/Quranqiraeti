{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-core.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-surahs.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-mushaf.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-muhaffiz.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-videos.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/og/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ai-index.json",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|og/|sitemap.*\\.xml$|robots\\.txt$|llms\\.txt$|llms-full\\.txt$|\\.well-known/llms\\.txt$|ai-index\\.json$).*)",
      "destination": "/index.html"
    }
  ]
}
