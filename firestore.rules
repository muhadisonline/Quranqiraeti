rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar: Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAyahNoteId(id) {
      return id is string && id.size() >= 3 && id.size() <= 12 && id.matches('^[0-9]{1,3}_[0-9]{1,3}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'mahir1999a@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidPageKey(key) {
      return key in [
        'home',
        'shorts',
        'quran',
        'surah',
        'mushaf_page',
        'muhaffiz',
        'video',
        'verse_of_day',
        'about',
        'request'
      ];
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidPageTelemetryEvent(data) {
      return data.keys().hasAll([
          'eventId',
          'pageKey',
          'pageLabel',
          'path',
          'status',
          'httpStatus',
          'loadTimeMs',
          'sessionId',
          'referrerType',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'eventId',
          'pageKey',
          'pageLabel',
          'path',
          'status',
          'httpStatus',
          'loadTimeMs',
          'sessionId',
          'referrerType',
          'createdAt'
        ]) &&
        isValidId(data.eventId) &&
        isValidPageKey(data.pageKey) &&
        data.pageLabel is string && data.pageLabel.size() >= 1 && data.pageLabel.size() <= 100 &&
        data.path is string && data.path.size() >= 1 && data.path.size() <= 180 && data.path.matches('^/[a-zA-Z0-9_\\-/]*$') &&
        data.status in ['ok', 'slow', 'error'] &&
        data.httpStatus is int && data.httpStatus >= 100 && data.httpStatus <= 599 &&
        data.loadTimeMs is int && data.loadTimeMs >= 0 && data.loadTimeMs <= 120000 &&
        data.sessionId is string && data.sessionId.size() >= 4 && data.sessionId.size() <= 80 && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.referrerType in ['direct', 'internal', 'search', 'youtube', 'other'] &&
        data.createdAt == request.time;
    }

    function isValidPageHealthRecord(data) {
      return data.keys().hasAll([
          'pageKey',
          'label',
          'routePattern',
          'status',
          'statusNote',
          'lastLatencyMs',
          'lastCheckedAt',
          'checkedByUid'
        ]) &&
        data.keys().hasOnly([
          'pageKey',
          'label',
          'routePattern',
          'status',
          'statusNote',
          'lastLatencyMs',
          'lastCheckedAt',
          'checkedByUid'
        ]) &&
        isValidPageKey(data.pageKey) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
        data.routePattern is string && data.routePattern.size() >= 1 && data.routePattern.size() <= 120 &&
        data.status in ['ok', 'degraded', 'down'] &&
        data.statusNote is string && data.statusNote.size() <= 240 &&
        data.lastLatencyMs is int && data.lastLatencyMs >= 0 && data.lastLatencyMs <= 120000 &&
        data.lastCheckedAt == request.time &&
        data.checkedByUid == request.auth.uid;
    }

    function isValidTelegramSubEvent(data) {
      return data.keys().hasAll([
          'eventId',
          'chatHash',
          'encryptedPayload',
          'active',
          'hourBaku',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'eventId',
          'chatHash',
          'encryptedPayload',
          'active',
          'hourBaku',
          'createdAt'
        ]) &&
        isValidId(data.eventId) &&
        data.chatHash is string && data.chatHash.size() >= 16 && data.chatHash.size() <= 64 && data.chatHash.matches('^[a-f0-9]+$') &&
        data.encryptedPayload is string && data.encryptedPayload.size() >= 16 && data.encryptedPayload.size() <= 1024 && data.encryptedPayload.matches('^[a-zA-Z0-9+/=:\\-]+$') &&
        data.active is bool &&
        data.hourBaku is int && data.hourBaku >= 0 && data.hourBaku <= 23 &&
        data.createdAt == request.time;
    }

    function isValidUserAyahNote(data) {
      return data.keys().hasAll([
          'ownerUid',
          'noteId',
          'surahNumber',
          'ayahNumber',
          'surahName',
          'pageNumber',
          'arabicText',
          'translation',
          'note',
          'savedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'noteId',
          'surahNumber',
          'ayahNumber',
          'surahName',
          'pageNumber',
          'arabicText',
          'translation',
          'note',
          'savedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        isValidAyahNoteId(data.noteId) &&
        data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.ayahNumber is int && data.ayahNumber >= 1 && data.ayahNumber <= 286 &&
        data.surahName is string && data.surahName.size() >= 1 && data.surahName.size() <= 80 &&
        data.pageNumber is int && data.pageNumber >= 0 && data.pageNumber <= 604 &&
        data.arabicText is string && data.arabicText.size() <= 4000 &&
        data.translation is string && data.translation.size() <= 4000 &&
        data.note is string && data.note.size() <= 500 &&
        data.savedAt is string && data.savedAt.size() >= 1 && data.savedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Admins Registry: Only verified admins can read/manage
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isSignedIn() && request.auth.uid == adminUid));
      allow list: if isAdmin();
      allow create: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isValidId(adminUid) && isAdmin() && adminUid != request.auth.uid;
    }

    // Connected Page Telemetry Events: Append-only strictly validated creates; admin-only reads/deletes
    match /page_events/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(eventId) &&
        isValidPageTelemetryEvent(incoming()) &&
        incoming().eventId == eventId;
      allow update: if false;
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // Per-Page Health Status Snapshots: Admin-only read/write
    match /page_health/{pageKey} {
      allow get: if isValidPageKey(pageKey) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidPageKey(pageKey) &&
        isAdmin() &&
        isValidPageHealthRecord(incoming()) &&
        incoming().pageKey == pageKey;
      allow update: if isValidPageKey(pageKey) &&
        isAdmin() &&
        isValidPageHealthRecord(incoming()) &&
        incoming().pageKey == existing().pageKey &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'label',
          'routePattern',
          'status',
          'statusNote',
          'lastLatencyMs',
          'lastCheckedAt',
          'checkedByUid'
        ]);
      allow delete: if isValidPageKey(pageKey) && isAdmin();
    }

    // Encrypted Telegram /abune subscription events: Append-only validated writes; admin-only reads/deletes
    match /telegram_sub_events/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(eventId) &&
        isValidTelegramSubEvent(incoming()) &&
        incoming().eventId == eventId;
      allow update: if false;
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // User-owned Quran Bookmarks & Personal Reflection Notes
    match /users/{userId}/ayah_notes/{noteId} {
      allow get: if isValidId(userId) &&
        isValidAyahNoteId(noteId) &&
        isVerifiedUser() &&
        request.auth.uid == userId;
      allow list: if isValidId(userId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        resource.data.ownerUid == request.auth.uid;
      allow create: if isValidId(userId) &&
        isValidAyahNoteId(noteId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        isValidUserAyahNote(incoming()) &&
        incoming().ownerUid == userId &&
        incoming().noteId == noteId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidAyahNoteId(noteId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        isValidUserAyahNote(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().noteId == existing().noteId &&
        incoming().surahNumber == existing().surahNumber &&
        incoming().ayahNumber == existing().ayahNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'surahName',
          'pageNumber',
          'arabicText',
          'translation',
          'note',
          'savedAt',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) &&
        isValidAyahNoteId(noteId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        existing().ownerUid == userId;
    }
  }
}
